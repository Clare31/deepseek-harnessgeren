+/** Embed the transparent character atlas into the self-contained client bundle. */
+import { readFile, writeFile } from 'node:fs/promises'
+const root = new URL('../', import.meta.url)
+const bytes = await readFile(new URL('assets/shadow-team.webp', root))
+await writeFile(new URL('src/client/shadow-art.ts', root), `/** Transparent role atlas generated from the user supplied visual reference. */\nexport const shadowAtlas = "data:image/webp;base64,${bytes.toString('base64')}"\n`)
