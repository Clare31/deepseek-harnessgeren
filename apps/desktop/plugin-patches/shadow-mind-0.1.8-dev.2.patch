diff --git a/src/client/ShadowWorkspace.tsx b/src/client/ShadowWorkspace.tsx
new file mode 100644
index 0000000000..c569d30668
--- /dev/null
+++ b/src/client/ShadowWorkspace.tsx
@@ -0,0 +1,84 @@
+import { useState } from 'react'
+import type { PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { ShadowMindStatus, ShadowReviewCycle, ShadowRunView } from '../runtime/types.ts'
+import type { ShadowMindLocaleKey } from './locales.ts'
+import { ShadowAvatar } from './ShadowAvatar.tsx'
+import css from './ShadowWorkspace.module.css'
+
+type Translate = (key: ShadowMindLocaleKey, values?: Record<string, string | number>) => string
+
+/**
+ * Explain only observed model requests, tools and lifecycle stages.
+ * @param run Current run snapshot.
+ * @param t Locale dictionary reader.
+ * @returns Localized activity without model content.
+ */
+export function activityLabel(run: ShadowRunView, t: Translate): string {
+  if (run.phase !== 'running') {
+    const keys = { report: 'reviewReport', silent: 'reviewSilent', not_relevant: 'reviewNotRelevant', aborted: 'reviewAborted', failed: 'reviewFailed' } as const
+    return t(keys[run.phase])
+  }
+  if (run.stage === 'relay') return t('relayingRole')
+  if (run.stage === 'validate' || run.stage === 'dispose') return t('validatingRole')
+  if (run.activity === 'tool') return `${t('workingTool')} · ${run.toolName ?? ''}`
+  if (run.activity === 'tool-complete') return `${t('toolComplete')} · ${run.toolName ?? ''}`
+  return t(run.activity === 'model' ? 'workingModel' : 'preparingRole')
+}
+
+/** Runtime hooks injected into the resident composer dock. */
+export interface ShadowWorkspaceInjected {
+  readonly useCycles: (id: SessionId) => readonly ShadowReviewCycle[]
+  readonly useStatus: (id: SessionId) => ShadowMindStatus | undefined
+  readonly openSession: (id: SessionId) => void
+  readonly pause: (id: SessionId) => Promise<unknown>
+  readonly resume: (id: SessionId) => Promise<unknown>
+  readonly poke: (id: SessionId) => void
+}
+
+type WorkspaceProps = PropsRuntime<'conversation.input.dock'> & PropsLocale<'settings.shadowMind'> & ShadowWorkspaceInjected
+
+/**
+ * Resident per-session overview while the root and its reviewers work.
+ * @param props Session-scoped state, actions and translated copy.
+ * @returns The live team overview, or null before reviews exist.
+ */
+export function ShadowWorkspace({ session, useCycles, useStatus, openSession, pause, resume, poke, t }: WorkspaceProps) {
+  const cycles = useCycles(session.sessionId)
+  const status = useStatus(session.sessionId)
+  const [error, setError] = useState<string>()
+  const [pending, setPending] = useState(false)
+  const activeCycles = cycles.filter(cycle => cycle.scheduling || (cycle.queued?.length ?? 0) > 0 || cycle.runs.some(run => run.phase === 'running'))
+  const visible = activeCycles.length > 0 ? activeCycles : cycles.slice(-1)
+  const runs = visible.flatMap(cycle => cycle.runs)
+  const queued = visible.flatMap(cycle => cycle.queued ?? [])
+  if (runs.length === 0 && queued.length === 0 && !visible.some(cycle => cycle.scheduling)) return null
+  const finished = runs.filter(run => run.phase !== 'running').length
+  const toggle = (): void => {
+    setPending(true); setError(undefined)
+    void (status?.paused === true ? resume(session.sessionId) : pause(session.sessionId)).then(
+      () => { poke(session.sessionId) },
+      (cause: unknown) => { setError(cause instanceof Error ? cause.message : String(cause)) },
+    ).finally(() => { setPending(false) })
+  }
+  return <section className={css.dock} data-shadow-workspace aria-label={t('teamProgress')}>
+    <header className={css.header}><strong>{t('teamProgress')}</strong><small>{t('teamProgressHint')}</small>
+      <div className={css.actions}><button type="button" disabled={pending} onClick={toggle}>{t(status?.paused === true ? 'resumeReview' : 'pauseReview')}</button></div>
+    </header>
+    <div className={css.roles}>
+      {runs.map(run => <article className={css.role} key={run.runId} data-running={run.phase === 'running'} data-shadow-role={run.shadowId}>
+        <ShadowAvatar id={run.shadowId} /><div className={css.detail}><strong>{run.shadowName}</strong>
+          <span className={css.activity}>{run.phase !== 'running' ? null : <span className={css.pulse} aria-hidden />}{activityLabel(run, t)}</span>
+          {run.route === undefined ? null : <small>{run.route}</small>}
+          {run.completedTools === undefined ? null : <small>{t('completedTools', { count: run.completedTools })}</small>}
+          {run.childSessionId === undefined ? null : <button type="button" onClick={() => { openSession(run.childSessionId!) }}>{t('childSession')}</button>}
+        </div>
+      </article>)}
+      {queued.map((role, index) => <article className={css.role} key={`${role.shadowId}-${index}`} data-shadow-queued>
+        <ShadowAvatar id={role.shadowId} /><div className={css.detail}><strong>{role.shadowName}</strong><span>{t('queuedRole')}</span></div>
+      </article>)}
+    </div>
+    <p className={css.summary}>{t('teamSummary', { reports: runs.filter(run => run.phase === 'report').length, done: finished, total: runs.length + queued.length })}</p>
+    {error === undefined ? null : <p className={css.error} role="alert">{t('operationFailed')}: {error}</p>}
+  </section>
+}
